{
  "name": "demodogs",
  "private": true,
  "description": "DemoDogs: a mobile top-down combat racer drawn with animated sprite stacks.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @demodogs/client --filter @demodogs/signal dev",
    "build": "pnpm --filter @demodogs/client build",
    "preview": "pnpm --filter @demodogs/client preview",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "content:validate": "vitest run --project content validate",
    "bench:sim": "SIM_BENCH=1 vitest run --project content simbench --disableConsoleIntercept",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "play:smoke": "pnpm build && node scripts/play-smoke.mjs",
    "play:editor": "pnpm build && node scripts/play-editor.mjs",
    "play:cups": "pnpm build && node scripts/play-cups.mjs",
    "overdraw": "pnpm build && node scripts/overdraw.mjs",
    "look": "pnpm build && node scripts/capture-look.mjs",
    "speed": "pnpm build && node scripts/capture-speed.mjs",
    "audio": "pnpm build && node scripts/capture-audio.mjs",
    "sky": "pnpm build && node scripts/capture-sky.mjs",
    "traced": "pnpm build && node scripts/capture-traced.mjs",
    "ground": "pnpm build && node scripts/capture-ground.mjs",
    "life": "pnpm build && node scripts/capture-life.mjs",
    "bones": "pnpm build && node scripts/capture-bones.mjs",
    "bumps": "pnpm build && node scripts/capture-bumps.mjs",
    "cars": "pnpm build && node scripts/capture-cars.mjs",
    "tracks": "pnpm build && node scripts/capture-tracks.mjs",
    "world": "pnpm build && node scripts/capture-world.mjs",
    "bridge": "pnpm build && node scripts/capture-bridge.mjs",
    "res": "pnpm build && node scripts/resolution.mjs",
    "perf:start": "pnpm build && node scripts/perf-start.mjs",
    "perf:fight": "pnpm build && node scripts/perf-fight.mjs",
    "slices": "pnpm build && node scripts/capture-slices.mjs",
    "ui": "pnpm build && node scripts/capture-ui.mjs",
    "play:lesson": "pnpm build && node scripts/play-lesson.mjs",
    "bots": "node scripts/bot-lab.mjs",
    "bots:clip": "pnpm build && node scripts/capture-bots.mjs",
    "verify": "pnpm check && pnpm play:smoke",
    "deploy:pages": "bash scripts/deploy-pages.sh",
    "signal": "pnpm --filter @demodogs/signal start",
    "play:net": "pnpm build && node scripts/play-net.mjs && node scripts/play-net.mjs relay && node scripts/play-net.mjs relay track && node scripts/play-net.mjs relay rough"
  },
  "browserslist": [
    "baseline 2026"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
